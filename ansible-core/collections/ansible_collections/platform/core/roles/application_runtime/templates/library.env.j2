{{ lookup('ansible.builtin.file', application_runtime_job.envSource, rstrip=false) if application_runtime_job.envSource else '' }}
SERVER_ID={{ inventory_hostname }}
{% for server in groups['all'] | reject('equalto', 'localhost') | sort %}
SERVER_{{ loop.index }}_ID={{ server }}
SERVER_{{ loop.index }}_IP={{ hostvars[server].ansible_host | default(server) }}
SERVER_{{ loop.index }}_HOSTNAME={{ (hostvars[server].platform_host | default({})).desiredHostname | default(server, true) }}
{% endfor %}
