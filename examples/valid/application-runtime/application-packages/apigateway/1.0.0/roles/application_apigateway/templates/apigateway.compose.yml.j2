services:
  {{ application_instance_id }}:
    extends:
      file: {{ application_runtime.base_compose_path | to_json }}
      service: {{ application_runtime.base_service | to_json }}
    image: {{ application_runtime.image | to_json }}
    container_name: {{ application_runtime.container_name | to_json }}
    entrypoint: {{ application_effective.command | to_json }}
    command: []
    user: {{ application_effective.user | to_json }}
    restart: {{ application_effective.restart | to_json }}
    environment:
{{ application_environment | to_nice_yaml(indent=2) | indent(6, true) }}
    labels:
      platform.installer.project: {{ application_project_id | to_json }}
      platform.installer.library: {{ library_runtime.library_id | to_json }}
      platform.installer.instance: {{ application_instance_id | to_json }}
      platform.installer.host: {{ library_runtime.host_id | to_json }}
      platform.installer.config-digest: {{ application_config_digest | to_json }}
    ports:
{% for name, port in application_effective.ports.items() %}
      - "0.0.0.0:{{ port.published }}:{{ port.container }}"
{% endfor %}
    volumes:
      - {{ (application_runtime.config_path ~ '/default.conf:/etc/nginx/conf.d/default.conf:ro') | to_json }}
