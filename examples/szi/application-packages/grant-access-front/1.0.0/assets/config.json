{% set szi = hostvars['localhost'].application_snapshot.snapshot.applicationLibraries.libraries[application_runtime_job.libraryId] %}
{% set connection = szi.instances[application_instance_id].connections.sso %}
{% set audit_id = szi.instances | dict2items | selectattr('value.applicationName', 'equalto', 'grant-access-audit') | map(attribute='key') | first %}
{% set grant_id = szi.instances | dict2items | selectattr('value.applicationName', 'equalto', 'grant-access') | map(attribute='key') | first %}
{
  "production": true,
  "apiHost": {{ connection.parameters.proxy_url | to_json }},
  "keycloakHost": {{ connection.url | to_json }},
  "auditHost": {{ (connection.parameters.proxy_url ~ '/' ~ audit_id) | to_json }},
  "visibilityZone": "",
  "nginxLogoutHost": {{ (connection.parameters.proxy_url ~ '/' ~ application_instance_id ~ '/logout') | to_json }},
  "withoutPasswordEdition": false,
  "grantAccessNginxPath": {{ ('/' ~ grant_id) | to_json }},
  "canary": false,
  "enableUserMultiGroup": false,
  "filterGroups": true,
  "heartbeatEnabled": false,
  "heartbeatIntervalSec": 60,
  "showHeaderButtons": true
}
