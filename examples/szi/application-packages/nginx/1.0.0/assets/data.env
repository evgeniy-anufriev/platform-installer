{% set szi_instances = hostvars['localhost'].application_snapshot.snapshot.applicationLibraries.libraries[application_runtime_job.libraryId].instances %}
{% set endpoint_domain = platform_desired_state.endpointGroups[platform_desired_state.applicationLibraryDeployments[application_runtime_job.libraryId].applications['nginx'].overrides.endpoint.endpoint_group].address.domain %}
{% set keycloak_id = (szi_instances | dict2items | selectattr('value.applicationName', 'equalto', 'keycloak') | map(attribute='key') | first) %}
{% set grant_access_id = (szi_instances | dict2items | selectattr('value.applicationName', 'equalto', 'grant-access') | map(attribute='key') | first) %}
{% set audit_id = (szi_instances | dict2items | selectattr('value.applicationName', 'equalto', 'grant-access-audit') | map(attribute='key') | first) %}
{% set front_id = (szi_instances | dict2items | selectattr('value.applicationName', 'equalto', 'grant-access-front') | map(attribute='key') | first) %}
ALARM_SERVICE=""
ALARM_VIEW_SERVICE=""
CLIENT_LIMITED_ACCESS="https://{{ grant_access_id }}.{{ endpoint_domain }}"
COMMON_REDIRECT_URL=""
CSPA_HMI_BACKEND=""
CSPA_IMPEXP=""
DATA_MANAGER=""
ENDPOINTS_LIMITED_ACCESS="/v1/roles/remove"
EVO_SCHEDULER=""
GAA_HOST="https://{{ audit_id }}.{{ endpoint_domain }}"
GA_HOST="https://{{ grant_access_id }}.{{ endpoint_domain }}"
GA_HOST_CANARY=""
GAF_HOST="https://{{ front_id }}.{{ endpoint_domain }}"
GAF_HOST_CANARY=""
HEARTBEAT_ENABLED=false
HMI_BACKEND=""
IP_LIMITED_ACCESS=""
KEYCLOAK_HOST="https://{{ keycloak_id }}.{{ endpoint_domain }}"
REALM="master"
PERFORMANCE_LOGS="false"
SDKU_KNP_BACKEND=""
SDKU_MKR_BACKEND=""
SDKU_MKR_VIEW_SERVICE=""
SDKU_VTOR=""
ALARM_VIEW_SERVICE_CSPA=""
HMI_BACKEND_CSPA=""
HMI_FRONTEND_CSPA=""
