{% set szi = hostvars['localhost'].application_snapshot.snapshot.applicationLibraries.libraries[application_runtime_job.libraryId] %}
{% macro url(name) -%}
{% set app_id = szi.instances | dict2items | selectattr('value.applicationName', 'equalto', name) | map(attribute='key') | first %}
{{- 'https://' ~ hostvars['localhost'].platform_endpoint_sources[app_id].endpoint.fqdn -}}
{%- endmacro %}
{% set public = szi.providedConnections.sso %}
{% set front_id = szi.instances | dict2items | selectattr('value.applicationName', 'equalto', 'grant-access-front') | map(attribute='key') | first %}
CLIENT_LIMITED_ACCESS="{{ url('grant-access') }}"
ENDPOINTS_LIMITED_ACCESS="/v1/roles/remove"
GAA_HOST="{{ url('grant-access-audit') }}"
GA_HOST="{{ url('grant-access') }}"
GA_HOST_CANARY=""
GAF_HOST="{{ url('grant-access-front') }}"
GAF_HOST_CANARY=""
HEARTBEAT_ENABLED="false"
IP_LIMITED_ACCESS=""
KEYCLOAK_HOST="{{ public.url }}"
REALM="{{ public.parameters.realm }}"
PERFORMANCE_LOGS="false"
COMMON_REDIRECT_URL="{{ url('nginx') }}/{{ front_id }}/"
