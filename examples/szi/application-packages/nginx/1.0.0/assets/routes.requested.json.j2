{% set ns = namespace(routes={}) %}
{% for consumer in application_runtime_job.integrationConsumers %}
{% for placement in consumer.placements.values() %}
{% if placement.endpointUrl is defined and consumer.applicationId not in ns.routes %}
{% set _ = ns.routes.update({consumer.applicationId: {'endpoint': placement.endpointUrl, 'subpath': '/' ~ consumer.applicationId, 'parameters': placement.parameters.IDENTITY_ROUTE | default({})}}) %}
{% endif %}
{% endfor %}
{% endfor %}
{{ {'owner': 'platform.application.routes/v1:' ~ application_runtime_job.projectId ~ ':' ~ application_runtime_job.libraryId ~ ':' ~ application_instance_id, 'routes': ns.routes} | to_json }}
