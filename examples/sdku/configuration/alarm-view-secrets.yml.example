---
# Merge into ordinary group_vars; replace deployment/profile references for your project.
# Host membership: platform_application_libraries: {sdku-dm: {}, cspa: {}}
# Runtime credentials are entered in the UI session or supplied to standalone Ansible.
# No plaintext passwords belong in this fragment.
platform_desired_state:
  applicationLibraryDeployments:
    sdku-dm:
      libraryRef: sdku@1.0.0
      runtimeRef: docker-apps
      bindings:
        database: {deploymentRef: postgres-apps}
        analytics: {deploymentRef: clickhouse-apps}
        cache: {deploymentRef: redis-apps}
        messaging: {deploymentRef: kafka-apps}
        secrets: {deploymentRef: vault-apps}
        application-pki: {profileRef: application-pki}
      connection_defaults:
        kafka: {connectionRef: SASL_SSL}
        redis: {connectionRef: sentinel}
      resources:
        history: {kind: clickhouse.database, binding: analytics, mode: managed, parameters: {name: sdku_dm}}
        alarms_db: {kind: postgresql.database, binding: database, mode: managed, parameters: {name: sdku_alarm_view}}
      applications:
        alarm-view-service:
          accounts:
            postgres: {mode: managed, credentials: {password: {source: {kind: generated}}}}
            clickhouse: {mode: managed, credentials: {password: {source: {kind: generated}}}}
            kafka: {mode: managed, credentials: {password: {source: {kind: generated}}}}
            redis: {mode: managed, credentials: {password: {source: {kind: generated}}}}
            sentinel: {mode: managed, credentials: {password: {source: {kind: generated}}}}
          overrides:
            environment:
              JAVA_OPTS: -Xmx768m
              JAVA_TOOL_OPTIONS: -Xmx768m
              SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE: "10"
              SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE: "2"
              EVO_SERVICES_CONSENSUS_SERVICE_HEALTH_CHECK_TIMEOUT: "5000"
            readiness: {mode: healthcheck, delay: 5, retries: 60}
    cspa:
      libraryRef: cspa@1.0.0
      runtimeRef: docker-apps
      bindings:
        database: {deploymentRef: postgres-apps}
        analytics: {deploymentRef: clickhouse-apps}
        cache: {deploymentRef: redis-apps}
        messaging: {deploymentRef: kafka-apps}
        secrets: {deploymentRef: vault-apps}
        application-pki: {profileRef: application-pki}
      connection_defaults:
        kafka: {connectionRef: SASL_SSL}
        redis: {connectionRef: sentinel}
      resources:
        history: {kind: clickhouse.database, binding: analytics, mode: managed, parameters: {name: cspa}}
        alarms_db: {kind: postgresql.database, binding: database, mode: managed, parameters: {name: cspa_alarm_view}}
      applications:
        alarm-view-service:
          accounts:
            postgres: {mode: managed, credentials: {password: {source: {kind: runtime_secret_ref, ref: alarm-view-service-cspa-postgres-password}}}}
            clickhouse: {mode: managed, credentials: {password: {source: {kind: runtime_secret_ref, ref: alarm-view-service-cspa-clickhouse-password}}}}
            kafka: {mode: managed, credentials: {password: {source: {kind: runtime_secret_ref, ref: alarm-view-service-cspa-kafka-password}}}}
            redis: {mode: managed, credentials: {password: {source: {kind: runtime_secret_ref, ref: alarm-view-service-cspa-redis-password}}}}
            sentinel: {mode: managed, credentials: {password: {source: {kind: runtime_secret_ref, ref: alarm-view-service-cspa-sentinel-password}}}}
          overrides:
            environment:
              JAVA_OPTS: -Xmx768m
              JAVA_TOOL_OPTIONS: -Xmx768m
              SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE: "10"
              SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE: "2"
              EVO_SERVICES_CONSENSUS_SERVICE_HEALTH_CHECK_TIMEOUT: "5000"
            readiness: {mode: healthcheck, delay: 5, retries: 60}
            ports:
              port-1: {container: 10022, published: 10022}
