---
# Merge this fragment into the project's ordinary inventory/group_vars.
# References below must name existing deployments of THAT project.
# This is not a standalone runnable inventory.
# Requires a runtime containing direct Kafka/PostgreSQL resource keys.

platform_desired_state:
  applicationLibraryDeployments:
    sdku-main:
      libraryRef: sdku@1.0.0
      runtimeRef: docker-apps
      # Optional; empty value restores the package default ~/<library instance ID>.
      runtime_directory: /data/scada/sdku-main
      overrides:
        environment:
          KAFKA_CONSUMER_REQUEST_TIMEOUT_MS: "60000"
          KAFKA_PRODUCER_REQUEST_TIMEOUT_MS: "60000"
      bindings:
        database: {deploymentRef: postgres-apps}
        analytics: {deploymentRef: clickhouse-apps}
        cache: {deploymentRef: redis-apps}
        messaging: {deploymentRef: kafka-apps}
        secrets: {deploymentRef: vault-apps}
        application-pki: {profileRef: application-pki}
      connection_defaults:
        kafka: {connectionRef: SASL_SSL}
        # Choose sentinel only for a Sentinel-backed Redis connection.
        redis: {connectionRef: client}
      resources:
        dm-meta: {kind: redis.key, binding: cache, parameters: {}}
        alert-hdl: {kind: redis.key, binding: cache, parameters: {}}
        alert-class: {kind: redis.key, binding: cache, parameters: {}}
        history: {kind: clickhouse.database, binding: analytics, parameters: {}}
        model: {kind: postgresql.database, binding: database, parameters: {name: tn-scada}}
        alarms_db: {kind: postgresql.database, binding: database, parameters: {name: sdku_alarm_view}}
        preferences: {kind: postgresql.database, binding: database, parameters: {name: user-preferences}}
        ef-store: {kind: postgresql.database, binding: database, parameters: {name: ef-store}}
        main: {kind: kafka.topic, binding: messaging, parameters: {}}
        main_compact: {kind: kafka.topic, binding: messaging, parameters: {}}
        alarms: {kind: kafka.topic, binding: messaging, parameters: {}}
        alarms_compact: {kind: kafka.topic, binding: messaging, parameters: {}}
      applications:
        hmi-backend:
          overrides:
            environment:
              ALARMSERVICE_URL_ROOT: ""
              GAAUDIT_URL_ROOT: ""
            ports:
              port-1: {container: 10101, published: 18101}
        data-manager:
          overrides:
            environment:
              JAVA_OPTS: "-Xmx2048m"
# Configure environment, shared parameters, secret sources, resources and mounts before Verify.
# Library ID is sdku-main; instance overrides use slot keys, not computed IDs.
