services:
  {{ application_instance_id }}:
    extends:
      "file": {{ application_runtime.base_compose_path | to_json }}
      "service": backend
    image: {{ application_runtime.image | to_json }}
    container_name: {{ application_runtime.container_name | to_json }}
    command: []
    entrypoint: ["/usr/bin/vault", "agent", "-config=/opt/vault/agent.hcl"]
    working_dir: "/usr/local/app/"
{% if application_effective.user is defined %}
    user: {{ application_effective.user | to_json }}
{% endif %}
    restart: {{ application_effective.restart | to_json }}
    environment:
{% set common_environment = library_runtime.defaults.environment %}
{% for name, value in application_environment.items() %}
{% if name not in common_environment or (value | string) != (common_environment[name] | string) %}
      {{ name | to_json }}: {{ (value | string) | to_json }}
{% endif %}
{% endfor %}
    labels:
      "platform.installer.project": {{ application_project_id | to_json }}
      "platform.installer.library": {{ library_runtime.library_id | to_json }}
      "platform.installer.instance": {{ application_instance_id | to_json }}
      "platform.installer.host": {{ library_runtime.host_id | to_json }}
      "platform.installer.config-digest": {{ application_config_digest | to_json }}
    ports:
{% for port in application_effective.ports.values() %}
      - "{{ port.published }}:{{ port.container }}"
{% endfor %}
    volumes:
      - {{ (application_runtime.vault_path ~ ':/opt/vault:ro') | to_json }}
      - {{ (application_runtime.pki_path ~ ':/opt/application/pki:ro') | to_json }}
      - {{ ((application_effective.parameters.mount_sources['mount-1'] | default(undef(hint='Configure SDKU mount /usr/local/app/project-libs'), true)) ~ ':/usr/local/app/project-libs:ro') | to_json }}
      - {{ ((application_effective.parameters.mount_sources['mount-2'] | default(undef(hint='Configure SDKU mount /usr/local/app/imitator'), true)) ~ ':/usr/local/app/imitator:ro') | to_json }}
    deploy:
      "resources":
          limits:
              memory: 4G
