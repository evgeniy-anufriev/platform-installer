services:
  {{ application_instance_id }}:
    extends:
      "file": {{ application_runtime.base_compose_path | to_json }}
      "service": {{ application_runtime.base_service | to_json }}
    image: {{ application_runtime.image | to_json }}
    container_name: {{ application_runtime.container_name | to_json }}
    command: []
    entrypoint: {{ application_effective.command | to_json }}
{% if application_effective.user is defined %}
    user: {{ application_effective.user | to_json }}
{% endif %}
    restart: {{ application_effective.restart | to_json }}
    environment:
{{ application_environment | to_nice_yaml(indent=2) | indent(6, true) }}
    labels:
      "platform.installer.project": {{ application_project_id | to_json }}
      "platform.installer.library": {{ library_runtime.library_id | to_json }}
      "platform.installer.instance": {{ application_instance_id | to_json }}
      "platform.installer.host": {{ library_runtime.host_id | to_json }}
      "platform.installer.config-digest": {{ application_config_digest | to_json }}
    ports:
{% for port in application_effective.ports.values() %}
      - "{{ port.published }}:{{ port.container }}"
{% endfor %}
    volumes:
      - {{ (application_runtime.pki_path ~ '/certificate.pem:/etc/nginx/host.crt:ro') | to_json }}
      - {{ (application_runtime.pki_path ~ '/private-key.pem:/etc/nginx/host.key:ro') | to_json }}
      - {{ (application_runtime.pki_path ~ '/ca-chain.pem:/etc/nginx/ca-chain.pem:ro') | to_json }}
      - {{ (application_runtime.config_path ~ '/hmi-frontend-para.conf:/etc/nginx/conf.d/hmi-frontend-para.conf:ro') | to_json }}
{% set public_host = application_instance_id ~ '.' ~ platform_desired_state.endpointGroups[application_effective.endpoint.endpoint_group].address.domain %}
    healthcheck:
      "interval": 30s
      "retries": 10
      "test":
          - CMD-SHELL
          - >-
            curl --fail --silent --show-error --output /dev/null
            --cacert /etc/nginx/ca-chain.pem
            --resolve {{ public_host }}:{{ application_effective.ports['port-1'].container }}:127.0.0.1
            https://{{ public_host }}:{{ application_effective.ports['port-1'].container }}/
      "timeout": 15s
    deploy:
      "resources":
          limits:
              memory: 1G
