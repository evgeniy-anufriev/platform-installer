{
  "clientId": "{{ application_instance_id }}",
  "name": "{{ application_instance_id }}",
  "rootUrl": "{{ application_connections.sso.parameters.proxy_url }}/{{ application_instance_id }}/",
  "adminUrl": "",
  "baseUrl": "",
  "surrogateAuthRequired": false,
  "enabled": true,
  "alwaysDisplayInConsole": false,
  "bearerOnly": false,
  "consentRequired": false,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": true,
  "directAccessGrantsEnabled": true,
  "serviceAccountsEnabled": true,
  "publicClient": false,
  "frontchannelLogout": true,
  "fullScopeAllowed": true,
  "clientAuthenticatorType": "client-secret",
  "protocol": "openid-connect",
  "notBefore": 0,
  "nodeReRegistrationTimeout": -1,
  "redirectUris": [
    "{{ application_connections.sso.parameters.proxy_url }}/{{ application_instance_id }}/*"
  ],
  "webOrigins": [
    "{{ application_connections.sso.parameters.proxy_url }}"
  ],
  "attributes": {
    "backchannel.logout.revoke.offline.tokens": "false",
    "backchannel.logout.session.required": "true",
    "backend": "true",
    "display.on.consent.screen": "false",
    "isOpenId": "false",
    "oauth2.device.authorization.grant.enabled": "true",
    "oidc.ciba.grant.enabled": "true",
    "ui_available": "false"
  },
  "authenticationFlowBindingOverrides": {},
  "protocolMappers": [
    {
      "name": "Client Host",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usersessionmodel-note-mapper",
      "consentRequired": false,
      "config": {
        "access.token.claim": "true",
        "claim.name": "clientHost",
        "id.token.claim": "true",
        "introspection.token.claim": "true",
        "jsonType.label": "String",
        "user.session.note": "clientHost",
        "userinfo.token.claim": "true"
      }
    },
    {
      "name": "Client ID",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usersessionmodel-note-mapper",
      "consentRequired": false,
      "config": {
        "access.token.claim": "true",
        "claim.name": "client_id",
        "id.token.claim": "true",
        "introspection.token.claim": "true",
        "jsonType.label": "String",
        "user.session.note": "client_id",
        "userinfo.token.claim": "true"
      }
    },
    {
      "name": "Client IP Address",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usersessionmodel-note-mapper",
      "consentRequired": false,
      "config": {
        "access.token.claim": "true",
        "claim.name": "clientAddress",
        "id.token.claim": "true",
        "introspection.token.claim": "true",
        "jsonType.label": "String",
        "user.session.note": "clientAddress",
        "userinfo.token.claim": "true"
      }
    }
  ],
  "defaultClientScopes": [
    "acr",
    "basic",
    "email",
    "profile",
    "roles",
    "web-origins"
