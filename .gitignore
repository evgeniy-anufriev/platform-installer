*.py[cod]
*.pyo
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.venv/
venv/
env/

# Ansible local state
*.retry
.ansible/
fact_cache/

# Go build/test output
bin/
*.test
*.out

# Frontend dependencies
node_modules/
frontend/package.json.md5

# OS/editor metadata
.DS_Store
Thumbs.db
*.swp
