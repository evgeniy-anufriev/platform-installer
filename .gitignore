# Generated Ansible workspaces and runtime evidence
.runtime/
runs/
bundle/
/cache/

# Local user-created project workspaces
Projects/

# Secrets must never be committed
secrets/
*.vault-password
*.private-key

# Local tools and editor state
.idea/
.vscode/
*.tmp
*.log

# Python runtime and test cache
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.venv/
venv/
env/

# Ansible local state
*.retry
.ansible/
fact_cache/

# Go build/test output
/bin/
# Keep build icons, manifests and platform resources in Git.
/build/bin/
*.test
*.out

# Frontend dependencies
node_modules/
/frontend/dist/
/.vite/
frontend/package.json.md5

# Local dependency caches and GitLab CI intermediate artifacts
/.npm/
/.go-cache/
/.go-path/
/npm-archives/
/npm-deps.tar.gz
/frontend-node-modules.tar.gz

# OS/editor metadata
.DS_Store
Thumbs.db
*.swp
