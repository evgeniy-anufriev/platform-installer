{
  "$id": "https://platform.installer/schemas/services/clickhouse/configuration-v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dataDirectory": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "dataRoot": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "defaultCredential": {
      "additionalProperties": false,
      "properties": {
        "passwordSecretRef": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "passwordSecretRef"
      ],
      "type": "object"
    },
    "interserverPort": {
      "maximum": 65535,
      "minimum": 1,
      "type": "integer"
    },
    "keeperClientPort": {
      "maximum": 65535,
      "minimum": 1,
      "type": "integer"
    },
    "keeperRaftPort": {
      "maximum": 65535,
      "minimum": 1,
      "type": "integer"
    },
    "nativePort": {
      "maximum": 65535,
      "minimum": 1,
      "type": "integer"
    },
    "port": {
      "maximum": 65535,
      "minimum": 1,
      "type": "integer"
    },
    "tlsProfile": {
      "minLength": 1,
      "type": "string"
    }
  },
  "title": "ClickHouse desired configuration",
  "type": "object"
}
