# Platform-managed local bootstrap access.
local all {{ platform_postgresql_user }} peer
local all {{ platform_postgresql_admin_superuser.username }} peer
{% if platform_postgresql_mode == 'pg_auto_failover' %}
local pg_auto_failover autoctl_node trust
{% endif %}
host all {{ platform_postgresql_admin_superuser.username }} 127.0.0.1/32 scram-sha-256
host all {{ platform_postgresql_admin_superuser.username }} ::1/128 scram-sha-256
{% if platform_postgresql_mode == 'pg_auto_failover' %}
# HA traffic is TLS-only; no plaintext host rule is permitted.
{% for monitor in platform_postgresql_instances | selectattr('roles', 'contains', 'monitor') %}
# pg_auto_failover 2.2 sends a fixed, non-secret probe password and only checks
# whether PostgreSQL accepts a protocol connection. Scope this trust exception
# to that dedicated role, database, TLS connections, and the monitor /32.
hostssl postgres pgautofailover_monitor {{ monitor.address }}/32 trust
{% endfor %}
{% for member in platform_postgresql_instances %}
hostssl pg_auto_failover {{ platform_postgresql_monitor_credential.username }} {{ member.address }}/32 {{ platform_postgresql_failover_auth }}
hostssl replication {{ platform_postgresql_replication_credential.username }} {{ member.address }}/32 {{ platform_postgresql_failover_auth }}
hostssl postgres {{ platform_postgresql_replication_credential.username }} {{ member.address }}/32 {{ platform_postgresql_failover_auth }}
{% endfor %}
{% endif %}
# Client access remains TLS-only and requires SCRAM authentication.
{% for cidr in ([_platform_postgresql_client_subnet] + (platform_postgresql_client_cidrs | default([]))) | unique %}
hostssl all all {{ cidr }} scram-sha-256
{% endfor %}
