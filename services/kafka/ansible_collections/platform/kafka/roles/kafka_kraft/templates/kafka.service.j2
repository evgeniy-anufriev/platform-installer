[Unit]
Description=Apache Kafka 4.3.1 KRaft member %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ platform_kafka_user }}
Group={{ platform_kafka_group }}
EnvironmentFile={{ platform_kafka_config_directory }}/{% if _platform_kafka_legacy_single %}{{ platform_kafka_service_name }}{% else %}%i{% endif %}/systemd.env
ExecStart={{ platform_kafka_install_directory }}/bin/kafka-server-start.sh $KAFKA_CONFIG_FILE
Restart=on-failure
RestartSec=5
LimitNOFILE=100000

[Install]
WantedBy=multi-user.target
