[Unit]
Description=Apache Kafka 4.3.1 KRaft
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ platform_kafka_user }}
Group={{ platform_kafka_group }}
ExecStart={{ platform_kafka_install_directory }}/bin/kafka-server-start.sh {{ platform_kafka_config_file }}
Restart=on-failure
RestartSec=5
LimitNOFILE=100000

[Install]
WantedBy=multi-user.target
