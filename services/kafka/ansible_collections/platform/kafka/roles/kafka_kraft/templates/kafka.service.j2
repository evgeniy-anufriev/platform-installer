# {{ platform_kafka_name }}-managed: {{ kafka_member.systemd_unit_name }}
[Unit]
Description={{ kafka_member.systemd_description }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ platform_kafka_user }}
Group={{ platform_kafka_group }}
EnvironmentFile={{ kafka_member.systemd_environment_pattern }}
ExecStart={{ platform_kafka_install_directory }}/bin/kafka-server-start{{ platform_kafka_script_extension }} $KAFKA_CONFIG_FILE
Restart=on-failure
RestartSec=5
LimitNOFILE=100000

[Install]
WantedBy=multi-user.target
