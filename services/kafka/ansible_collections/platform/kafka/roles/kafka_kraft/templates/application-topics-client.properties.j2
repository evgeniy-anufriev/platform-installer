security.protocol={{ application_topic_candidate.securityProtocol | default('SSL' if application_topic_candidate.tls else 'PLAINTEXT') }}
{% if application_topic_candidate.securityProtocol | default('') == 'SASL_SSL' %}
sasl.mechanism=SCRAM-SHA-512
{% set files = platform_application_secret_files | default({}) | combine(platform_application_credential_files | default({})) %}
{% set admin_password = lookup('ansible.builtin.file', files[platform_kafka_application_job.adminPasswordRef], rstrip=false) %}
{% set admin_jaas = 'org.apache.kafka.common.security.scram.ScramLoginModule required username="admin" password=' ~ (admin_password | to_json(ensure_ascii=false)) ~ ';' %}
sasl.jaas.config={{ admin_jaas | platform.core.platform_java_properties_value }}
{% endif %}
request.timeout.ms={{ platform_kafka_application_timeout_ms }}
default.api.timeout.ms={{ platform_kafka_application_timeout_ms }}
{% if application_topic_candidate.tls %}
{% set plan = application_topic_candidate.pkiPlans[0] %}
ssl.endpoint.identification.algorithm=https
ssl.truststore.location={{ plan.targetDirectory }}/{{ 'ca-chain.pem' if platform_kafka_store_type == 'PEM' else 'truststore.p12' }}
ssl.truststore.type={{ platform_kafka_store_type }}
ssl.keystore.location={{ application_kafka_private.path ~ '/identity.pem' if platform_kafka_store_type == 'PEM' else plan.targetDirectory ~ '/keystore.p12' }}
ssl.keystore.type={{ platform_kafka_store_type }}
{% if platform_kafka_store_type == 'PKCS12' %}
{% set password = lookup('ansible.builtin.file', platform_pki_secret_files[plan.storePasswordSecretRef], rstrip=false) | trim | platform.core.platform_java_properties_value %}
ssl.truststore.password={{ password }}
ssl.keystore.password={{ password }}
ssl.key.password={{ password }}
{% endif %}
{% endif %}
