{% for item in kafka_effective_config | dict2items | sort(attribute='key') %}
{% if item.value is boolean %}
{{ item.key }}={{ 'true' if item.value else 'false' }}
{% elif item.value is number %}
{{ item.key }}={{ item.value }}
{% elif item.value is string %}
{{ item.key }}={{ item.value }}
{% endif %}
{% endfor %}
