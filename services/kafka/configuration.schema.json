{
  "$id": "https://platform.installer/schemas/services/kafka/configuration-v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "advancedConfig": {
      "additionalProperties": true,
      "type": "object"
    },
    "clientPort": {
      "maximum": 65535,
      "minimum": 1,
      "type": "integer"
    },
    "controllerPort": {
      "maximum": 65535,
      "minimum": 1,
      "type": "integer"
    },
    "dataDirectory": {
      "minLength": 1,
      "type": "string"
    },
    "logRetentionHours": {
      "minimum": 1,
      "type": "integer"
    },
    "nodeId": {
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
    },
    "quorumMode": {
      "enum": [
        "dynamic",
        "static"
      ],
      "type": "string"
    },
    "runtimePathNamespace": {
      "minLength": 1,
      "type": "string"
    }
  },
  "title": "Apache Kafka desired configuration",
  "type": "object"
}
