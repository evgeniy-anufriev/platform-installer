{
  "$id": "https://platform.installer/schemas/services/kafka/configuration-v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "advancedConfig": {
      "additionalProperties": true,
      "type": "object"
    },
    "configDirectory": {
      "minLength": 1,
      "type": "string"
    },
    "dataDirectory": {
      "minLength": 1,
      "type": "string"
    },
    "listeners": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "advertisedAddress": {
            "minLength": 1,
            "type": "string"
          },
          "bindAddress": {
            "minLength": 1,
            "type": "string"
          },
          "port": {
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          },
          "purpose": {
            "enum": [
              "client",
              "interBroker",
              "controller"
            ],
            "type": "string"
          },
          "securityProtocol": {
            "enum": [
              "PLAINTEXT",
              "SSL"
            ],
            "type": "string"
          }
        },
        "required": [
          "purpose",
          "securityProtocol",
          "port"
        ],
        "type": "object"
      },
      "minProperties": 1,
      "type": "object"
    },
    "logDirectory": {
      "minLength": 1,
      "type": "string"
    },
    "logRetentionHours": {
      "minimum": 1,
      "type": "integer"
    },
    "nodeId": {
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
    },
    "quorumMode": {
      "enum": [
        "dynamic",
        "static"
      ],
      "type": "string"
    },
    "runtimePathNamespace": {
      "minLength": 1,
      "type": "string"
    },
    "tlsProfile": {
      "minLength": 1,
      "type": "string"
    }
  },
  "title": "Apache Kafka desired configuration",
  "type": "object"
}
