{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.installer/schemas/services/kafka/configuration-v1alpha1.schema.json",
  "title": "Kafka KRaft desired configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "clientPort": {"type": "integer", "minimum": 1, "maximum": 65535},
    "controllerPort": {"type": "integer", "minimum": 1, "maximum": 65535},
    "dataDirectory": {"type": "string", "minLength": 1},
    "logRetentionHours": {"type": "integer", "minimum": 1}
  }
}
