zone "{{ platform_bind_zone_projection.zone }}" IN {
{% if platform_deployments[platform_bind_deployment.key].roles | first == 'primary' %}
  type primary;
  file "{{ platform_bind_zone_file }}";
{% if platform_bind_zone_projection.secondaries | length > 0 %}
  allow-transfer { {% for secondary in platform_bind_zone_projection.secondaries %}{{ secondary.address }}; {% endfor %} };
  also-notify { {% for secondary in platform_bind_zone_projection.secondaries %}{{ secondary.address }}; {% endfor %} };
  notify yes;
{% endif %}
  update-policy local;
{% else %}
  type secondary;
  primaries { {{ platform_bind_zone_projection.primary.address }}; };
  file "{{ platform_bind_zone_file }}";
{% endif %}
};
