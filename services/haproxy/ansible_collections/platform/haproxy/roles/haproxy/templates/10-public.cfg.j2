frontend public
    bind *:{{ platform_haproxy_public_port }} ssl crt {{ platform_haproxy_pki_directory }}/haproxy.pem
    mode http
    http-request set-var(txn.route_host) req.hdr(host),lower,regsub(:[0-9]+$,)
{% set endpoint_groups = platform_desired_state.endpointGroups | default({}) %}
    acl platform_endpoint_domain var(txn.route_host) -m end -i{% for group in endpoint_groups.values() | map(attribute='address') | map(attribute='domain') | unique | sort %} .{{ group }}{% endfor %}{{ '\n' }}
{% for group, settings in endpoint_groups | dictsort %}
    acl {{ group }} var(txn.route_host) -m end -i .{{ settings.address.domain }}
    use_backend %[var(txn.route_host),field(1,'.')]-{{ group }} if {{ group }}
{% endfor %}
    http-request return status 503 unless platform_endpoint_domain
