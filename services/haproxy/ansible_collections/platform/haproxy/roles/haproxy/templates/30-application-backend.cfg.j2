backend {{ platform_haproxy_application_backend.backendName }}
    balance {{ platform_haproxy_application_backend.settings.balance }}
    default-server{% if platform_haproxy_application_backend.settings.ssl %} ssl verify {{ platform_haproxy_application_backend.settings.sslVerify }} ca-file {{ platform_haproxy_pki_directory }}/02-ca-chain.pem{% endif %}{% if platform_haproxy_application_backend.settings.check %} check fall {{ platform_haproxy_application_backend.settings.fall }} rise {{ platform_haproxy_application_backend.settings.rise }}{% endif %}{{ '\n' }}
{% for target in platform_haproxy_application_backend.targets %}
    server {{ target.serverName }} {{ target.address }}:{{ target.port }}
{% endfor %}
