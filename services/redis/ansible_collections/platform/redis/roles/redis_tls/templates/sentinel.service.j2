# platform-redis-managed: {{ platform_redis_deployment_id }}/{{ redis_member.id }}/sentinel
[Unit]
Description=Platform Redis Sentinel TLS member {{ redis_member.id }}
After=platform-redis@{{ redis_member.instance_name }}.service
Requires=platform-redis@{{ redis_member.instance_name }}.service

[Service]
Type=simple
User={{ platform_redis_user }}
Group={{ platform_redis_group }}
ExecStart=/usr/bin/redis-sentinel {{ redis_member.config_directory }}/sentinel.conf
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
