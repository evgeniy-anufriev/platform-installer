{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-installer.local/contracts/application-libraries/v1alpha5/package.schema.json",
  "title": "Library package installation scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "name",
    "version",
    "files",
    "user_scenarios"
  ],
  "properties": {
    "apiVersion": {
      "const": "platform.installer/application-package/v1alpha5"
    },
    "kind": {
      "const": "LibraryPackage"
    },
    "name": {
      "$ref": "../v1alpha1/package.schema.json#/properties/name"
    },
    "version": {
      "$ref": "../v1alpha1/package.schema.json#/properties/version"
    },
    "files": {
      "$ref": "../v1alpha1/package.schema.json#/properties/files"
    },
    "scripts": {
      "$ref": "../v1alpha4/package.schema.json#/properties/scripts"
    },
    "render": {
      "allOf": [
        {
          "$ref": "../v1alpha1/package.schema.json#/properties/render"
        },
        {
          "not": {
            "required": [
              "agent_template"
            ]
          }
        }
      ]
    },
    "user_scenarios": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description",
          "setting",
          "action"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "setting": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
          },
          "action": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "slot_ref",
                  "script_ref"
                ],
                "properties": {
                  "kind": {
                    "const": "package_script"
                  },
                  "slot_ref": {
                    "type": "string",
                    "maxLength": 128,
                    "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
                  },
                  "script_ref": {
                    "type": "string",
                    "maxLength": 128,
                    "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "resource_ref",
                  "restore_on_create"
                ],
                "properties": {
                  "kind": {
                    "const": "resource_initialization"
                  },
                  "resource_ref": {
                      "$ref": "../v1alpha1/deployments.schema.json#/additionalProperties/properties/resources/propertyNames"
                  },
                  "restore_on_create": {
                    "$ref": "../v1alpha1/deployments.schema.json#/$defs/restoreOnCreate"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
