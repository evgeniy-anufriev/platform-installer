{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Application library deployments v1alpha1",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
    "maxLength": 128
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "registry_credentials": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*(?::[0-9]+)?$"
        },
        "maxProperties": 128,
        "additionalProperties": {
          "type": "object",
          "required": [
            "username",
            "password"
          ],
          "additionalProperties": false,
          "properties": {
            "username": {
              "$ref": "#/$defs/registryCredential"
            },
            "password": {
              "$ref": "#/$defs/registryCredential"
            }
          }
        }
      },
      "overrides": {
        "$ref": "settings.schema.json#/$defs/common"
      },
      "vault_ref": {
        "type": "object",
        "properties": {
          "binding": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          }
        },
        "required": [
          "binding"
        ],
        "additionalProperties": false
      },
      "libraryRef": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"
      },
      "runtimeRef": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
        "maxLength": 128
      },
      "bindings": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
          "maxLength": 128
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "deploymentRef": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
              "maxLength": 128
            },
            "profileRef": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
              "maxLength": 128
            },
            "providedConnectionRef": {
              "type": "object",
              "required": [
                "libraryId",
                "name"
              ],
              "properties": {
                "libraryId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
                  "maxLength": 128
                },
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
                  "maxLength": 128
                }
              },
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false,
          "not": {
            "allOf": [
              {
                "required": [
                  "providedConnectionRef"
                ]
              },
              {
                "anyOf": [
                  {
                    "required": [
                      "deploymentRef"
                    ]
                  },
                  {
                    "required": [
                      "profileRef"
                    ]
                  }
                ]
              }
            ]
          }
        },
        "maxProperties": 128
      },
      "resources": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9_-]*$",
          "maxLength": 128
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "postgresql.database",
                "postgresql.schema",
                "clickhouse.database",
                "kafka.topic",
                "redis.key"
              ]
            },
            "binding": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
              "maxLength": 128
            },
            "parameters": {
              "type": "object"
            },
            "mode": {
              "enum": [
                "managed",
                "existing"
              ]
            },
            "databaseRef": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9_-]*$",
              "maxLength": 128
            }
          },
          "required": [
            "kind",
            "binding",
            "parameters"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "postgresql.database"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "properties": {
                  "parameters": {
                    "type": "object",
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "restore_on_create": {
                        "$ref": "#/$defs/restoreOnCreate"
                      }
                    }
                  }
                }
              },
              "else": {
                "properties": {
                  "parameters": {
                    "not": {
                      "required": [
                        "restore_on_create"
                      ]
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "existing"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "properties": {
                  "parameters": {
                    "not": {
                      "required": [
                        "restore_on_create"
                      ]
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "redis.key"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "mode"
                      ]
                    },
                    {
                      "required": [
                        "databaseRef"
                      ]
                    }
                  ]
                },
                "properties": {
                  "parameters": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "maxProperties": 128
      },
      "shared_secrets": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
          "maxLength": 128
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "source": {
              "$ref": "settings.schema.json#/$defs/source"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        "maxProperties": 128
      },
      "connection_defaults": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
          "maxLength": 128
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "connectionRef": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "maxProperties": 128
      },
      "applications": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
          "maxLength": 128
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "overrides": {
              "$ref": "settings.schema.json#/$defs/settings"
            },
            "accounts": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
                "maxLength": 128
              },
              "additionalProperties": {
                "$ref": "settings.schema.json#/$defs/account"
              },
              "maxProperties": 128
            },
            "credentials": {
              "type": "object",
              "properties": {
                "vault_binding": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
                  "maxLength": 128
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "maxProperties": 128
      },
      "runtime_directory": {
        "maxLength": 4096,
        "type": "string"
      },
      "resource_defaults": {
        "type": "object"
      },
      "provided_connections": {
        "$ref": "provided-connections.schema.json#/$defs/overrides"
      }
    },
    "required": [
      "libraryRef",
      "runtimeRef"
    ],
    "additionalProperties": false
  },
  "$defs": {
    "restoreOnCreate": {
      "type": "object",
      "required": [
        "source",
        "sha256",
        "format"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "format": {
          "const": "pg_custom"
        }
      }
    },
    "registryCredential": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "allOf": [
            {
              "$ref": "settings.schema.json#/$defs/source"
            },
            {
              "properties": {
                "kind": {
                  "const": "runtime_secret_ref"
                }
              }
            }
          ]
        }
      }
    }
  },
  "maxProperties": 128,
  "$id": "https://platform-installer.local/contracts/application-libraries/v1alpha1/deployments.schema.json"
}
