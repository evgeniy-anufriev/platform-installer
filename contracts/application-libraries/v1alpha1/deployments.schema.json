{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Application library deployments v1alpha1",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
    "maxLength": 128
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "vault_ref": {
        "type": "object",
        "properties": {
          "binding": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}
        },
        "required": ["binding"],
        "additionalProperties": false
      },
      "libraryRef": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"
      },
      "runtimeRef": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
        "maxLength": 128
      },
      "bindings": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
          "maxLength": 128
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "deploymentRef": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
              "maxLength": 128
            },
            "profileRef": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
              "maxLength": 128
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "maxProperties": 128
      },
      "resources": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9_-]*$",
          "maxLength": 128
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "postgresql.database",
                "postgresql.schema",
                "clickhouse.database"
              ]
            },
            "binding": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
              "maxLength": 128
            },
            "parameters": {
              "type": "object"
            },
            "mode": {
              "enum": ["managed", "existing"]
            },
            "databaseRef": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9_-]*$",
              "maxLength": 128
            }
          },
          "required": [
            "kind",
            "binding",
            "parameters"
          ],
          "additionalProperties": false
        },
        "maxProperties": 128
      },
      "shared_secrets": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
          "maxLength": 128
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "source": {
              "$ref": "settings.schema.json#/$defs/source"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        "maxProperties": 128
      },
      "connection_defaults": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
          "maxLength": 128
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "connectionRef": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "maxProperties": 128
      },
      "applications": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
          "maxLength": 128
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "overrides": {
              "$ref": "settings.schema.json#/$defs/settings"
            },
            "accounts": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
                "maxLength": 128
              },
              "additionalProperties": {
                "$ref": "settings.schema.json#/$defs/account"
              },
              "maxProperties": 128
            },
            "credentials": {
              "type": "object",
              "properties": {
                "vault_binding": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
                  "maxLength": 128
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "maxProperties": 128
      }
    },
    "required": [
      "libraryRef",
      "runtimeRef"
    ],
    "additionalProperties": false
  },
  "maxProperties": 128,
  "$id": "https://platform-installer.local/contracts/application-libraries/v1alpha1/deployments.schema.json"
}
