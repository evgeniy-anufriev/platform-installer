{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Package file allowlist v1alpha1",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "platform.installer/application-package/v1alpha1"
    },
    "kind": {
      "enum": [
        "ApplicationPackage",
        "LibraryPackage"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "render": {
      "oneOf": [
        {
          "required": [
            "compose_template"
          ],
          "maxProperties": 2
        },
        {
          "required": [
            "base_compose_template",
            "base_compose_filename",
            "base_service"
          ],
          "maxProperties": 3
        }
      ],
      "properties": {
        "agent_template": {
          "type": "string", "minLength": 1, "maxLength": 256
        },
        "compose_template": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "base_service": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "base_compose_template": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "base_compose_filename": {
          "type": "string",
          "pattern": "^\\.[a-zA-Z0-9_-]+\\.ya?ml$"
        }
      },
      "type": "object",
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "name",
    "version",
    "files"
  ],
  "allOf": [{"if": {"properties": {"kind": {"const": "LibraryPackage"}}},
             "then": {"properties": {"render": {"not": {"required": ["agent_template"]}}}}}],
  "additionalProperties": false,
  "$id": "https://platform-installer.local/contracts/application-libraries/v1alpha1/package.schema.json"
}
