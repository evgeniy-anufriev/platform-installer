{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Package file allowlist v1alpha1",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "platform.installer/application-package/v1alpha1"
    },
    "kind": {
      "enum": [
        "ApplicationPackage",
        "LibraryPackage"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "scripts": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/script"}
    },
    "render": {
      "oneOf": [
        {
          "required": [
            "compose_template"
          ],
          "maxProperties": 2
        },
        {
          "required": [
            "base_compose_template",
            "base_compose_filename",
            "base_service"
          ],
          "maxProperties": 3
        }
      ],
      "properties": {
        "agent_template": {
          "type": "string", "minLength": 1, "maxLength": 256
        },
        "compose_template": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "base_service": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "base_compose_template": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "base_compose_filename": {
          "type": "string",
          "pattern": "^\\.[a-zA-Z0-9_-]+\\.ya?ml$"
        }
      },
      "type": "object",
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "name",
    "version",
    "files"
  ],
  "allOf": [{"if": {"properties": {"kind": {"const": "LibraryPackage"}}},
             "then": {"properties": {"render": {"not": {"required": ["agent_template"]}}}}}],
  "$defs": {
    "script": {
      "type": "object",
      "required": ["id", "source", "phase"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$", "maxLength": 128},
        "source": {"type": "string", "minLength": 1, "maxLength": 256},
        "phase": {"enum": ["before_start", "after_ready"]},
        "execution": {"enum": ["once", "each_target"]},
        "argv": {
          "type": "array", "maxItems": 128,
          "items": {"oneOf": [
            {"type": "string", "maxLength": 4096},
            {"type": "object", "required": ["valueFrom"], "additionalProperties": false,
             "properties": {
               "valueFrom": {"enum": ["applicationId", "projectId", "libraryId", "targetHostId", "parameter", "endpoint", "connection", "placement_https"]},
               "name": {"type": "string", "minLength": 1, "maxLength": 128},
               "application": {"type": "string", "minLength": 1, "maxLength": 128}
             }}
          ]}
        },
        "secretInputs": {
          "type": "object", "maxProperties": 32,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$", "maxLength": 128},
          "additionalProperties": {
            "type": "object", "required": ["valueFrom", "ref"], "additionalProperties": false,
            "properties": {
              "valueFrom": {"const": "runtime_secret"},
              "ref": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$", "maxLength": 128}
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$id": "https://platform-installer.local/contracts/application-libraries/v1alpha1/package.schema.json"
}
