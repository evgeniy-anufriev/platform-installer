{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Library definition defaults v1alpha1",
  "type": "object",
  "properties": {
    "defaults": {
      "$ref": "settings.schema.json#/$defs/common"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "slots": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "inherit_defaults": {
            "type": "boolean"
          },
          "applicationRef": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "required": {
            "type": "boolean"
          },
          "overrides": {
            "$ref": "settings.schema.json#/$defs/settings"
          }
        },
        "required": [
          "applicationRef"
        ],
        "additionalProperties": false
      },
      "maxProperties": 128
    },
    "connection_defaults": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "connectionRef": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "maxProperties": 128
    },
    "shared_secrets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "source": {
            "$ref": "settings.schema.json#/$defs/source"
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false
      },
      "maxProperties": 128
    },
    "connections": {
      "allOf": [
        {
          "$ref": "application.schema.json#/properties/connections"
        },
        {
          "type": "object"
        }
      ]
    },
    "runtime_directory": {
      "maxLength": 4096,
      "type": "string"
    },
    "resource_defaults": {
      "$ref": "#/$defs/resourceDefaults"
    }
  },
  "required": [
    "name",
    "version",
    "slots"
  ],
  "additionalProperties": false,
  "$id": "https://platform-installer.local/contracts/application-libraries/v1alpha1/library.schema.json",
  "$defs": {
    "resourceDefaults": {
      "type": "object",
      "properties": {
        "clickhouse": {
          "type": "object",
          "properties": {
            "tables": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "maxLength": 128
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "engine": {
                    "enum": [
                      "MergeTree",
                      "ReplacingMergeTree"
                    ]
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                          "maxLength": 128
                        },
                        "type": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 8192
                        },
                        "codec": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 8192
                        }
                      },
                      "required": [
                        "name",
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 256
                  },
                  "indexes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                          "maxLength": 128
                        },
                        "expression": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 8192
                        },
                        "type": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 8192
                        },
                        "granularity": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
                        "name",
                        "expression",
                        "type",
                        "granularity"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 128
                  },
                  "partition_by": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "primary_key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "order_by": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "sample_by": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "settings": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                      "maxLength": 128
                    },
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "maxProperties": 128
                  }
                },
                "required": [
                  "engine",
                  "columns",
                  "order_by"
                ],
                "additionalProperties": false
              },
              "maxProperties": 128
            },
            "databases": {
              "type": "object",
              "maxProperties": 128,
              "propertyNames": {
                "pattern": "^[a-z][A-Za-z0-9_-]*$",
                "maxLength": 128
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63
                  }
                }
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "kafka": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "topics": {
              "type": "object",
              "maxProperties": 128,
              "propertyNames": {
                "pattern": "^[a-z][A-Za-z0-9_-]*$",
                "maxLength": 128
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 249,
                    "pattern": "^[A-Za-z0-9._-]+$"
                  },
                  "partitions": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "replication_factor": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "config": {
                    "type": "object",
                    "maxProperties": 128,
                    "propertyNames": {
                      "pattern": "^[A-Za-z0-9._-]+$",
                      "maxLength": 128
                    },
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "postgresql": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "databases": {
              "type": "object",
              "maxProperties": 128,
              "propertyNames": {
                "pattern": "^[a-z][A-Za-z0-9_-]*$",
                "maxLength": 128
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63
                  }
                }
              }
            }
          }
        },
        "redis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keys": {
              "type": "object",
              "maxProperties": 128,
              "propertyNames": {
                "pattern": "^[a-z][A-Za-z0-9_-]*$",
                "maxLength": 128
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
