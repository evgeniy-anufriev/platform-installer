{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-installer.local/contracts/application-libraries/v1alpha1/settings.schema.json",
  "$defs": {
    "common": {
      "type": "object",
      "properties": {
        "environment": {
          "$ref": "#/$defs/settings/properties/environment"
        },
        "parameters": {
          "$ref": "#/$defs/settings/properties/parameters"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "generated"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "runtime_secret_ref"
            },
            "ref": {
              "type": "string",
              "pattern": "^(?:[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*|.*\\{\\{.+\\}\\}.*)$",
              "maxLength": 128
            }
          },
          "required": [
            "kind",
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "literal"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "vault_ref"
            },
            "binding": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
              "maxLength": 128
            },
            "mount": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
              "maxLength": 128
            },
            "document": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
              "maxLength": 128
            }
          },
          "required": [
            "kind",
            "binding",
            "mount",
            "document",
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "pki_credential"
            },
            "binding": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
              "maxLength": 128
            },
            "credential": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
              "maxLength": 128
            }
          },
          "required": [
            "kind",
            "binding",
            "credential"
          ],
          "additionalProperties": false
        }
      ]
    },
    "account": {
      "type": "object",
      "not": {
        "anyOf": [
          {
            "required": [
              "databaseAccess",
              "databaseRef"
            ]
          },
          {
            "required": [
              "databaseAccess",
              "grants"
            ]
          }
        ]
      },
      "properties": {
        "mode": {
          "enum": [
            "managed",
            "existing"
          ]
        },
        "databaseAccess": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "properties": {
              "databaseRef": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
                "maxLength": 128
              },
              "privileges": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "SELECT",
                    "INSERT",
                    "UPDATE",
                    "DELETE",
                    "CREATE"
                  ]
                }
              },
              "additionalCreatorRoles": {
                "type": "array",
                "maxItems": 256,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z_][a-z0-9_-]{0,62}$"
                }
              }
            },
            "required": [
              "databaseRef",
              "privileges"
            ],
            "additionalProperties": false
          }
        },
        "databaseRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
          "maxLength": 128
        },
        "credentials": {
          "type": "object",
          "properties": {
            "username": {
              "type": "object",
              "properties": {
                "source": {
                  "$ref": "#/$defs/source"
                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            },
            "password": {
              "type": "object",
              "properties": {
                "source": {
                  "$ref": "#/$defs/source"
                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "grants": {
          "oneOf": [
            {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "object"
              }
            },
            {
              "type": "object",
              "properties": {
                "commands": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 256,
                  "items": {
                    "type": "string",
                    "maxLength": 256
                  }
                },
                "keys": {
                  "type": "array",
                  "maxItems": 256,
                  "items": {
                    "type": "string",
                    "maxLength": 256
                  }
                },
                "channels": {
                  "type": "array",
                  "maxItems": 256,
                  "items": {
                    "type": "string",
                    "maxLength": 256
                  }
                }
              },
              "required": [
                "commands"
              ],
              "additionalProperties": false
            }
          ]
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "mode",
        "credentials"
      ],
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "user": {
          "type": "string"
        },
        "restart": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "ports": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "container": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "published": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "required": [
              "container",
              "published"
            ],
            "additionalProperties": false
          },
          "maxProperties": 128
        },
        "endpoint": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "listener": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
              "maxLength": 128
            },
            "endpoint_group": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
              "maxLength": 128
            },
            "haproxy": {
              "type": "object",
              "properties": {
                "backend": {
                  "$ref": "../../project/v2alpha1/desired-state.schema.json#/$defs/haproxyBackendSettingsPartial"
                }
              },
              "additionalProperties": false
            },
            "protocol": {
              "enum": [
                "http",
                "https"
              ]
            },
            "probe": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/[^\\s\\u0000-\\u001f\\u007f]*$",
                  "maxLength": 2048
                },
                "expected_status": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                "timeout": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60
                }
              },
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "accounts": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/account"
          },
          "maxProperties": 128
        },
        "provisioner": {
          "type": "object",
          "properties": {
            "type": {
              "const": "vault-agent"
            },
            "mode": {
              "const": "process-supervisor"
            },
            "auth": {
              "type": "object",
              "properties": {
                "method": {
                  "const": "approle"
                }
              },
              "required": [
                "method"
              ],
              "additionalProperties": false
            },
            "approle": {
              "type": "object",
              "properties": {
                "bind_secret_id": {
                  "const": false
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "secrets": {
              "type": "object",
              "properties": {
                "mount": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
                  "maxLength": 128
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "secret_bindings": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "format": {
                    "enum": [
                      "raw",
                      "kafka_scram_jaas"
                    ]
                  },
                  "source": {
                    "type": "object",
                    "properties": {
                      "account": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
                        "maxLength": 128
                      },
                      "field": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
                        "maxLength": 128
                      },
                      "library_secret": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
                        "maxLength": 128
                      }
                    },
                    "oneOf": [
                      {
                        "required": [
                          "account",
                          "field"
                        ],
                        "not": {
                          "required": [
                            "library_secret"
                          ]
                        }
                      },
                      {
                        "required": [
                          "library_secret"
                        ],
                        "not": {
                          "anyOf": [
                            {
                              "required": [
                                "account"
                              ]
                            },
                            {
                              "required": [
                                "field"
                              ]
                            }
                          ]
                        }
                      }
                    ],
                    "additionalProperties": false
                  },
                  "requires_connections": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]*$"
                    }
                  }
                },
                "required": [
                  "source"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "type",
            "mode"
          ],
          "additionalProperties": false
        },
        "readiness": {
          "properties": {
            "retries": {
              "minimum": 1,
              "maximum": 60,
              "type": "integer"
            },
            "delay": {
              "minimum": 1,
              "maximum": 30,
              "type": "integer"
            },
            "mode": {
              "enum": [
                "container",
                "healthcheck"
              ]
            }
          },
          "required": [
            "mode"
          ],
          "type": "object",
          "additionalProperties": false
        },
        "topicBindings": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z0-9_-]*$"
                }
              },
              {
                "type": "object",
                "maxProperties": 128,
                "propertyNames": {
                  "pattern": "^[a-z][A-Za-z0-9_-]*$",
                  "maxLength": 128
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^(?:[a-z][A-Za-z0-9_-]*)?$",
                  "maxLength": 128
                }
              }
            ]
          }
        },
        "config_files": {
          "items": {
            "oneOf": [
              {
                "required": [
                  "template"
                ]
              },
              {
                "required": [
                  "source"
                ]
              }
            ],
            "properties": {
              "destination": {
                "minLength": 1,
                "maxLength": 256,
                "type": "string"
              },
              "template": {
                "minLength": 1,
                "maxLength": 256,
                "type": "string"
              },
              "mode": {
                "enum": [
                  "0400",
                  "0440",
                  "0444",
                  "0600",
                  "0640",
                  "0644"
                ]
              },
              "source": {
                "minLength": 1,
                "maxLength": 256,
                "type": "string"
              }
            },
            "required": [
              "destination"
            ],
            "type": "object",
            "additionalProperties": false
          },
          "maxItems": 64,
          "type": "array"
        },
        "config_directories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "destination": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "file_mode": {
                "enum": [
                  "0400",
                  "0440",
                  "0444",
                  "0600",
                  "0640",
                  "0644"
                ]
              },
              "directory_mode": {
                "enum": [
                  "0700",
                  "0750",
                  "0755"
                ]
              }
            },
            "required": [
              "source",
              "destination"
            ],
            "additionalProperties": false
          }
        },
        "config_archives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "format": {
                "const": "tar.gz"
              },
              "destination": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "source",
              "format",
              "destination"
            ],
            "additionalProperties": false
          }
        },
        "connections": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "maxProperties": 128
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
