{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-installer.local/contracts/execution-capabilities/v1alpha2/schema.json",
  "title": "Platform Execution runtime capabilities with credentialed start negotiation",
  "type": "object",
  "required": ["apiVersion", "kind", "bootstrapProtocol", "coreVersion", "catalogDigest", "schemaDigest", "runtime", "supportedOperations", "executionStart"],
  "properties": {
    "apiVersion": {"const": "platform.installer/execution-capabilities/v1alpha2"},
    "kind": {"const": "ExecutionCapabilities"},
    "bootstrapProtocol": {"const": "v1alpha1"},
    "coreVersion": {"type": "string", "minLength": 1},
    "catalogDigest": {"$ref": "#/$defs/digest"},
    "schemaDigest": {"$ref": "#/$defs/digest"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "supportedOperations": {
      "type": "array",
      "items": {"enum": ["GetCapabilities", "ValidateProject", "BuildProjectSnapshot", "BuildDeploymentPlan", "StartExecution", "GetExecution", "GetEvents", "CancelExecution", "PutRuntimeSecretLease"]},
      "uniqueItems": true
    },
    "projectSnapshotRequestVersions": {"type": "array", "items": {"const": "platform.installer/project-snapshot-request/v1alpha1"}, "uniqueItems": true},
    "executionStart": {"type": "object", "required": ["protocol"], "properties": {"protocol": {"const": "StartExecution/v1alpha2"}}, "additionalProperties": false},
    "targetCredentialLease": {"$ref": "#/$defs/targetCredentialLease"}
  },
  "allOf": [
    {"if": {"required": ["targetCredentialLease"]}, "then": {"properties": {"supportedOperations": {"contains": {"const": "PutRuntimeSecretLease"}}}}}
  ],
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "runtime": {"type": "object", "required": ["bundleVersion", "bundleDigest"], "properties": {"bundleVersion": {"type": "string", "minLength": 1}, "bundleDigest": {"$ref": "#/$defs/digest"}}, "additionalProperties": false},
    "targetCredentialLease": {
      "type": "object",
      "required": ["protocol", "payloadVersions", "maxPayloadBytes", "requiredStartProtocol"],
      "properties": {
        "protocol": {"const": "PutRuntimeSecretLease/v1alpha1"},
        "payloadVersions": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "TargetCredentialLeasePayload/v1alpha1"}, "uniqueItems": true},
        "maxPayloadBytes": {"type": "integer", "minimum": 1, "maximum": 1114112},
        "requiredStartProtocol": {"const": "StartExecution/v1alpha2"}
      },
      "additionalProperties": false
    }
  }
}
