{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-installer.local/contracts/runtime-secret-descriptors/v1alpha4/schema.json",
  "title": "Safe target-free typed runtime input descriptors",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "projectIdentity",
    "projectRevision",
    "descriptors",
    "descriptorSetFingerprint",
    "applicationInputs"
  ],
  "properties": {
    "apiVersion": {
      "const": "BuildRuntimeSecretDescriptors/v1alpha4"
    },
    "projectIdentity": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "projectRevision": {
      "$ref": "../../runtime-secret-lease/v1alpha1/request.schema.json#/$defs/digest"
    },
    "descriptorSetFingerprint": {
      "$ref": "../../runtime-secret-lease/v1alpha1/request.schema.json#/$defs/digest"
    },
    "descriptors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirementRef",
          "purpose",
          "serviceDeployment",
          "displayLabel",
          "hosts",
          "requiredWhen",
          "operations"
        ],
        "properties": {
          "requirementRef": {
            "$ref": "../../target-credential-payload/v1alpha4/schema.json#/$defs/requirement"
          },
          "purpose": {
            "enum": [
              "PKI_STORE_PASSWORD",
              "SERVICE_PASSWORD",
              "SERVICE_ADMIN_TOKEN",
              "SERVICE_UNSEAL_SHARES"
            ]
          },
          "serviceDeployment": {
            "oneOf": [
              {
                "$ref": "../../target-credential-payload/v1alpha4/schema.json#/$defs/deployment"
              },
              {
                "type": "null"
              }
            ]
          },
          "displayLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "hosts": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "$ref": "../../target-credential-payload/v1alpha4/schema.json#/$defs/deployment"
            }
          },
          "requiredWhen": {
            "enum": [
              "ALWAYS",
              "INITIALIZED",
              "SEALED"
            ]
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "SERVICE_APPLY",
                "SERVICE_VERIFY"
              ]
            }
          }
        },
        "oneOf": [
          {
            "properties": {
              "purpose": {
                "const": "PKI_STORE_PASSWORD"
              },
              "serviceDeployment": {
                "const": null
              },
              "requiredWhen": {
                "const": "ALWAYS"
              },
              "operations": {
                "const": [
                  "SERVICE_APPLY",
                  "SERVICE_VERIFY"
                ]
              }
            }
          },
          {
            "properties": {
              "purpose": {
                "const": "SERVICE_PASSWORD"
              },
              "requiredWhen": {
                "const": "ALWAYS"
              },
              "operations": {
                "const": [
                  "SERVICE_APPLY",
                  "SERVICE_VERIFY"
                ]
              }
            }
          },
          {
            "properties": {
              "purpose": {
                "const": "SERVICE_ADMIN_TOKEN"
              },
              "requiredWhen": {
                "const": "INITIALIZED"
              },
              "operations": {
                "const": [
                  "SERVICE_APPLY",
                  "SERVICE_VERIFY"
                ]
              }
            }
          },
          {
            "properties": {
              "purpose": {
                "const": "SERVICE_UNSEAL_SHARES"
              },
              "requiredWhen": {
                "const": "SEALED"
              },
              "operations": {
                "const": [
                  "SERVICE_APPLY"
                ]
              }
            }
          }
        ]
      }
    },
    "applicationInputs": {
      "items": {
        "properties": {
          "providerDeployment": {
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "enum": [
              "APPLICATION_SECRET",
              "APPLICATION_VAULT_ADMIN_TOKEN",
              "APPLICATION_REGISTRY_USERNAME",
              "APPLICATION_REGISTRY_PASSWORD"
            ]
          },
          "operations": {
            "const": [
              "APPLICATION_LIBRARIES_APPLY",
              "APPLICATION_LIBRARIES_VERIFY"
            ]
          },
          "hosts": {
            "minItems": 1,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 256
          },
          "requirementRef": {
            "pattern": "^application-secret-[a-f0-9]{32}$",
            "type": "string"
          },
          "applicationLibraries": {
            "minItems": 1,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 256
          },
          "sourceRef": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
          },
          "displayLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirementRef",
          "purpose",
          "providerDeployment",
          "applicationLibraries",
          "hosts",
          "operations",
          "sourceRef",
          "displayLabel"
        ]
      },
      "type": "array"
    }
  }
}
