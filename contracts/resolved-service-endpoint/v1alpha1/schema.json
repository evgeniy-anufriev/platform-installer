{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-installer.local/contracts/resolved-service-endpoint/v1alpha1/schema.json",
  "title": "Resolved service endpoints",
  "type": "object",
  "required": ["apiVersion", "kind", "endpoints", "endpointFingerprint", "findings", "status"],
  "properties": {
    "apiVersion": { "const": "platform.installer/resolved-service-endpoint/v1alpha1" },
    "kind": { "const": "ResolvedServiceEndpoints" },
    "endpoints": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/endpoint" }
    },
    "endpointFingerprint": { "$ref": "#/$defs/digest" },
    "findings": { "type": "array", "items": { "type": "object" } },
    "status": { "enum": ["PASS", "BLOCKED"] }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "endpoint": {
      "type": "object",
      "required": ["serviceDeploymentId", "serviceType", "endpointGroupId", "fqdn", "sanDnsNames", "endpointFingerprint"],
      "properties": {
        "serviceDeploymentId": { "type": "string" },
        "serviceType": { "type": "string" },
        "endpointGroupId": { "type": "string" },
        "fqdn": { "type": "string" },
        "sanDnsNames": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "wildcardDnsNames": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "endpointFingerprint": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  }
}
