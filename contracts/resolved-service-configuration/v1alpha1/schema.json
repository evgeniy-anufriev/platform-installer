{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.installer.local/contracts/resolved-service-configuration/v1alpha1/schema.json",
  "title": "Resolved service configuration projection",
  "description": "Read-only derived logical configuration; never a desired-state source.",
  "type": "object",
  "required": ["apiVersion", "kind", "services", "opaqueVariables", "configurationFingerprint", "findings"],
  "properties": {
    "apiVersion": { "const": "platform.installer/resolved-service-configuration/v1alpha1" },
    "kind": { "const": "ResolvedServiceConfiguration" },
    "services": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/service" }
    },
    "configurationFingerprint": { "$ref": "#/$defs/digest" },
    "findings": { "type": "array", "items": { "type": "object" } },
    "opaqueVariables": {
      "type": "array",
      "items": { "$ref": "#/$defs/opaqueVariable" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "literal": {
      "type": ["string", "number", "integer", "boolean", "array", "object", "null"]
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "required": ["state", "value"],
          "properties": {
            "state": { "const": "RESOLVED" },
            "value": { "$ref": "#/$defs/literal" },
            "source": { "enum": ["DEFAULT", "OVERRIDE", "ROLE_DEFAULT", "DEPLOYMENT_OVERRIDE", "MEMBER_OVERRIDE", "STATIC_REFERENCE"] },
            "origin": { "enum": ["ROLE_DEFAULT", "DEPLOYMENT_OVERRIDE", "MEMBER_OVERRIDE"] },
            "reference": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["state", "reason"],
          "properties": {
            "state": { "const": "DEFERRED" },
            "reason": { "enum": ["NON_LITERAL_ROLE_DEFAULT", "NON_LITERAL_CONFIGURATION"] },
            "source": { "enum": ["DEFAULT", "ROLE_DEFAULT", "DEPLOYMENT_OVERRIDE", "MEMBER_OVERRIDE", "RUNTIME_DEFERRED"] },
            "expression": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["state", "reason"],
          "properties": {
            "state": { "enum": ["UNRESOLVED", "CYCLIC"] },
            "reason": { "enum": ["STATIC_REFERENCE_NOT_FOUND", "STATIC_REFERENCE_CYCLE"] },
            "source": { "const": "STATIC_REFERENCE" },
            "reference": { "type": "string", "minLength": 1 },
            "expression": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "variableContext": {
      "type": "object",
      "required": ["deploymentId", "memberId", "hostId"],
      "properties": {
        "deploymentId": { "type": "string", "minLength": 1 },
        "memberId": { "type": "string", "minLength": 1 },
        "hostId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "opaqueVariable": {
      "type": "object",
      "required": ["state", "name", "origin"],
      "properties": {
        "state": { "const": "OPAQUE" },
        "name": { "type": "string", "minLength": 1 },
        "origin": {
          "type": "object",
          "required": ["source", "path"],
          "properties": {
            "source": { "enum": ["ROLE_DEFAULT", "DEPLOYMENT_CONFIGURATION", "MEMBER_CONFIGURATION", "HOST_CONTEXT"] },
            "path": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "value": { "$ref": "#/$defs/literal" },
        "expression": { "type": "string", "minLength": 1 },
        "redacted": { "const": true }
      },
      "anyOf": [
        { "required": ["value"] },
        { "required": ["expression"] },
        { "required": ["redacted"] }
      ],
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": ["serviceType", "definitionVersion", "mode", "configuration", "inputs"],
      "properties": {
        "serviceType": { "type": "string", "minLength": 1 },
        "definitionVersion": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 },
        "configuration": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/value" }
        },
        "opaqueVariables": {
          "type": "array",
          "items": { "$ref": "#/$defs/opaqueVariable" }
        },
        "members": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": {
            "type": "object",
            "required": ["variableContext", "configuration", "configurationFingerprint"],
            "properties": {
              "variableContext": { "$ref": "#/$defs/variableContext" },
              "configuration": {
                "type": "object",
                "additionalProperties": { "$ref": "#/$defs/value" }
              },
              "opaqueVariables": {
                "type": "array",
                "items": { "$ref": "#/$defs/opaqueVariable" }
              },
              "configurationFingerprint": { "$ref": "#/$defs/digest" }
            },
            "additionalProperties": false
          }
        },
        "configurationFingerprint": { "$ref": "#/$defs/digest" },
        "inputs": {
          "type": "object",
          "required": ["serviceDefinitionDigest", "configurationSchemaDigest", "roleDefaultsDigest"],
          "properties": {
            "topologyFingerprint": { "$ref": "#/$defs/digest" },
            "serviceDefinitionDigest": { "$ref": "#/$defs/digest" },
            "configurationSchemaDigest": { "$ref": "#/$defs/digest" },
            "roleDefaultsDigest": { "$ref": "#/$defs/digest" },
            "mappingDigest": { "$ref": "#/$defs/digest" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
