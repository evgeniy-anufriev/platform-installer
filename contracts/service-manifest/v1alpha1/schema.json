{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-installer.local/contracts/service-manifest/v1alpha1/schema.json",
  "title": "Platform service package manifest",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "modes", "configurationSchema", "roleEntrypoints"],
  "properties": {
    "apiVersion": { "const": "platform.installer/service-manifest/v1alpha1" },
    "kind": { "const": "ServiceManifest" },
    "metadata": {
      "type": "object",
      "required": ["id", "version", "displayName"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "displayName": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "type": "string" },
        "category": { "$ref": "#/$defs/identifier" }
      },
      "patternProperties": { "^x-[A-Za-z0-9][A-Za-z0-9._-]*$": true },
      "additionalProperties": false
    },
    "modes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/mode" }
    },
    "listeners": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/listener" },
      "default": {}
    },
    "endpoint": { "$ref": "#/$defs/genericEndpoint" },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" },
      "default": []
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependencyKind" },
      "default": []
    },
    "configurationSchema": {
      "type": "object",
      "description": "Embedded or referenced JSON Schema for supported desired overrides.",
      "required": ["$ref"],
      "properties": { "$ref": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "configurationMapping": {
      "type": "object",
      "description": "Versioned logical configuration property to ordinary role variable mapping.",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": {
        "type": "object",
        "required": ["roleVariable"],
        "properties": {
          "roleVariable": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "scopes": {
            "type": "array",
            "items": { "enum": ["deployment", "member"] },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "configuration": {
      "type": "object",
      "required": ["settings"],
      "properties": {
        "additionalProperties": { "type": "boolean" },
        "unevaluatedProperties": { "type": "boolean" },
        "settings": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/configurationSetting" }
        }
      },
      "additionalProperties": false
    },
    "roleEntrypoints": {
      "type": "object",
      "required": ["apply", "verify"],
      "properties": {
        "validate": { "$ref": "#/$defs/roleEntrypoint" },
        "apply": { "$ref": "#/$defs/roleEntrypoint" },
        "verify": { "$ref": "#/$defs/roleEntrypoint" }
      },
      "patternProperties": { "^x-[A-Za-z0-9][A-Za-z0-9._-]*$": true },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifactRequirement" },
      "default": []
    },
    "compatibilityRef": { "type": "string", "minLength": 1 },
    "ui": {
      "type": "object",
      "description": "Optional presentation hints; never changes service semantics.",
      "properties": {
        "icon": { "type": "string" },
        "order": { "type": "integer" },
        "documentationTopic": { "type": "string" }
      },
      "patternProperties": { "^x-[A-Za-z0-9][A-Za-z0-9._-]*$": true },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "not": {
        "required": ["configuration", "configurationMapping"]
      }
    }
  ],
  "patternProperties": { "^x-[A-Za-z0-9][A-Za-z0-9._-]*$": true },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "mode": {
      "type": "object",
      "required": ["displayName", "memberRoles", "placement"],
      "properties": {
        "displayName": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "type": "string" },
        "memberRoles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "placement": {
          "type": "object",
          "required": ["explicit", "minMembers"],
          "properties": {
            "explicit": { "const": true },
            "minMembers": { "type": "integer", "minimum": 1 },
            "maxMembers": { "type": "integer", "minimum": 1 },
            "distinctHosts": { "type": "boolean", "default": false },
            "roleCardinality": {
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/identifier" },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "minimum": { "type": "integer", "minimum": 0 },
                  "maximum": { "type": "integer", "minimum": 0 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "configurationSchemaRef": { "type": "string", "minLength": 1 }
      },
      "patternProperties": { "^x-[A-Za-z0-9][A-Za-z0-9._-]*$": true },
      "additionalProperties": false
    },
    "listener": {
      "type": "object",
      "required": ["protocol"],
      "properties": {
        "protocol": { "enum": ["tcp", "udp", "http", "https"] },
        "defaultPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "tlsCapable": { "type": "boolean", "default": false },
        "scope": { "enum": ["member", "deployment"] }
      },
      "patternProperties": { "^x-[A-Za-z0-9][A-Za-z0-9._-]*$": true },
      "additionalProperties": false
    },
    "genericEndpoint": {
      "type": "object",
      "description": "Opt-in to NET-01 logical endpoint resolution. Transport and routing are deferred to NET-03.",
      "properties": {},
      "additionalProperties": false
    },
    "dependencyKind": {
      "type": "object",
      "required": ["capability"],
      "properties": {
        "capability": { "$ref": "#/$defs/identifier" },
        "required": { "type": "boolean", "default": true },
        "listener": { "$ref": "#/$defs/identifier" }
      },
      "patternProperties": { "^x-[A-Za-z0-9][A-Za-z0-9._-]*$": true },
      "additionalProperties": false
    },
    "roleEntrypoint": {
      "type": "object",
      "required": ["fqcn"],
      "properties": {
        "fqcn": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+\\.[a-z0-9_]+$"
        },
        "variablesPrefix": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_$"
        }
      },
      "additionalProperties": false
    },
    "artifactRequirement": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "requiredOffline": { "type": "boolean", "default": true }
      },
      "patternProperties": { "^x-[A-Za-z0-9][A-Za-z0-9._-]*$": true },
      "additionalProperties": false
    },
    "configurationSetting": {
      "type": "object",
      "required": ["kind", "roleVariable", "type", "scopes", "validation"],
      "properties": {
        "kind": { "enum": ["MANAGED", "ADVANCED"] },
        "roleVariable": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": { "enum": ["string", "integer", "number", "boolean", "object", "array", "null"] },
        "scopes": {
          "type": "array",
          "items": { "enum": ["deployment", "member"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "validation": { "type": "object" },
        "schema": { "type": "object" },
        "ui": {
          "type": "object",
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "description": { "type": "string" },
            "order": { "type": "integer" }
          },
          "patternProperties": { "^x-[A-Za-z0-9][A-Za-z0-9._-]*$": true },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
