{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-installer.local/contracts/artifacts/v1alpha1/schema.json",
  "title": "Local service artifact metadata",
  "type": "object",
  "required": ["apiVersion", "service", "artifacts"],
  "properties": {
    "apiVersion": {"const": "platform.installer/artifacts/v1alpha1"},
    "service": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "artifacts": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "os", "architecture", "filename", "mediaType", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "version": {"type": "string", "minLength": 1, "maxLength": 128},
          "os": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "architecture": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "filename": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"},
          "mediaType": {"enum": ["application/gzip", "application/x-gzip", "application/x-rpm", "application/octet-stream"]},
          "sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
          "source": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "packageSource": {"type": "object"},
    "testedPackageSets": {"type": "array"},
    "status": {"type": "string"}
  },
  "additionalProperties": false
}
