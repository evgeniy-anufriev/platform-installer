{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-installer.local/contracts/application-config/v1alpha1/schema.json",
  "title": "Platform Installer application configuration v1alpha1",
  "type": "object",
  "required": ["schemaVersion", "serverTypes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "serverTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/serverType"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "serverTypeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
    },
    "serverType": {
      "type": "object",
      "required": ["id", "displayName"],
      "properties": {
        "id": {"$ref": "#/$defs/serverTypeId"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "additionalProperties": false
    }
  }
}
