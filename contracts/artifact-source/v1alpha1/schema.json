{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-installer.local/contracts/artifact-source/v1alpha1/schema.json",
  "title": "Resolved artifact source",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "requirement", "targetNode", "source", "reason"],
  "properties": {
    "apiVersion": { "const": "platform.installer/artifact-source/v1alpha1" },
    "kind": { "const": "ResolvedArtifactSource" },
    "requirement": { "$ref": "#/$defs/requirement" },
    "targetNode": { "type": "string", "minLength": 1 },
    "source": { "enum": ["REPOSITORY", "OFFLINE_BUNDLE", "BLOCKED"] },
    "version": { "type": "string", "minLength": 1 },
    "artifactRef": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "sha256", "size", "type"],
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "type": { "enum": ["package", "archive", "file"] }
        }
      }
    },
    "reason": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "os", "architecture"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 }
      }
    }
  }
}
