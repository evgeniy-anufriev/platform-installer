{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-installer.local/contracts/project-snapshot-request/v1alpha1/schema.json",
  "title": "Candidate project snapshot request",
  "type": "object",
  "required": ["apiVersion", "kind", "requestId", "projectIdentity", "candidateProjectRevision", "projectArchiveDigest", "artifactLockDigest", "catalogLockDigest", "installerOwnedLogicalPaths", "projectContract", "snapshotContract", "editContract"],
  "properties": {
    "apiVersion": {"const": "platform.installer/project-snapshot-request/v1alpha1"},
    "kind": {"const": "BuildProjectSnapshotRequest"},
    "requestId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "projectIdentity": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "candidateProjectRevision": {"$ref": "#/$defs/digest"},
    "projectArchiveDigest": {"$ref": "#/$defs/digest"},
    "artifactLockDigest": {"$ref": "#/$defs/digest"},
    "catalogLockDigest": {"$ref": "#/$defs/digest"},
    "installerOwnedLogicalPaths": {
      "type": "array", "maxItems": 1026, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(ansible\\.cfg|inventory/hosts\\.yml|inventory/group_vars/all/platform-installer\\.yml|inventory/host_vars/[a-z0-9][a-z0-9-]{0,62}/platform-installer\\.yml)$"}
    },
    "projectContract": {"const": "v2alpha1"},
    "snapshotContract": {"const": "v1alpha1"},
    "editContract": {"const": "v1alpha2"}
  },
  "additionalProperties": false,
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
