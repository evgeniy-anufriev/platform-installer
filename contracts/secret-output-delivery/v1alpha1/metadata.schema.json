{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-installer.local/contracts/secret-output-delivery/v1alpha1/metadata.schema.json",
  "title": "Secret output package safe discovery metadata",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "packageId", "projectId", "deploymentId", "clusterId", "sourceRunId", "runtimeDigest", "generation", "state", "entries"],
  "properties": {
    "protocol": {"const": "SecretOutputDelivery/v1alpha1"},
    "packageId": {"$ref": "request.schema.json#/$defs/opaqueId"},
    "projectId": {"$ref": "request.schema.json#/$defs/identity"},
    "deploymentId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"},
    "clusterId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "sourceRunId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "runtimeDigest": {"$ref": "request.schema.json#/$defs/digest"},
    "generation": {"$ref": "request.schema.json#/$defs/generation"},
    "state": {"enum": ["READY", "ACKED_CLEANUP_PENDING", "DELIVERED"]},
    "entries": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "prefixItems": [{"const": "admin-token"}, {"const": "unseal-shares"}], "items": false
    }
  }
}
